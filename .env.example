# Runtime
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug

# Auth
JWT_SECRET=change_me_to_a_strong_secret_please
JWT_EXPIRES_IN=1h

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ll_express_api?schema=public

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Email (choose ONE: SMTP or Gmail)

# Preferred: Custom SMTP
EMAIL_FROM=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password

# Fallback: Gmail (App Password required)
# EMAIL_FROM=admin@example.com
# GMAIL_USER=your_gmail_account@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password

# Frontend reset URL (token appended as ?token=)
RESET_PASSWORD_URL_BASE=http://localhost:4200/reset-password

# BetterAuth (SUPER_ADMIN password resets)
BETTERAUTH_BASE_URL=https://your-betterauth.example
BETTERAUTH_API_TOKEN=your_betterauth_api_token
BETTERAUTH_FORGOT_PATH=/api/auth/forgot-password

# WhatsApp when a tax invoice is finalized (POST /billing/invoices)
# WHATSAPP_INVOICE_NOTIFY=true
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Optional: forward JSON to n8n/Make; build the WhatsApp step there (Meta / Twilio / etc.)
# WHATSAPP_INVOICE_WEBHOOK_URL=https://your-n8n.example/webhook/invoice-whatsapp
# Or Twilio WhatsApp (From must be an approved WhatsApp sender)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# COMPANY_SHORT_NAME=Luxur Dental

#AWS S3 configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_PUBLIC_URL=https://your-cdn-domain.com  # optional, for custom CDN
# Razorpay (clinic portal + admin billing online payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
