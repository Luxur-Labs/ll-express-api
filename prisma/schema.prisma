generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DOCTOR
  EMPLOYEE
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String?
  passwordHash          String
  role                  Role
  employeeType          EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  employeeTypeId        String?
  technicianGroup       TechnicianGroup?  @relation("GroupMembers", fields: [technicianGroupId], references: [id])
  technicianGroupId     String?
  leadingGroup          TechnicianGroup?  @relation("GroupLeader")
  
  // Security fields
  failedLoginAttempts   Int               @default(0)
  accountLockedUntil    DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?

  // Profile fields
  fullName              String?
  dateOfBirth           DateTime?
  contact               String?
  document              String?
  profilePhoto          String?
  
  // Relations
  ordersAsDoctor        Order[]           @relation("OrderDoctor")
  ordersAsReferredDoctor Order[]          @relation("OrderReferredDoctor")
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model EmployeeType {
  id    String  @id @default(uuid())
  name  String  @unique
  users User[]
}

model TechnicianGroup {
  id        String  @id @default(uuid())
  name      String  @unique
  description String?
  leaderId  String? @unique
  leader    User?   @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   User[]  @relation("GroupMembers")
}

model Clinic {
  id              String   @id @default(uuid())
  clinicName      String
  organizationId  String
  clientAddress   String
  contactNumber   String
  
  // Relations
  orders          Order[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  product     String
  warranty    String
  price       Decimal  @db.Decimal(10, 2)
  discount    Decimal  @db.Decimal(5, 2) @default(0)
  
  // Relations
  orderProducts OrderProduct[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Patient {
  id            String   @id @default(uuid())
  name          String
  age           Int
  gender        String
  contactNumber String
  
  // Relations
  orders        Order[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  
  // Relations
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId       String
  
  doctor          User     @relation("OrderDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId        String
  
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId        String
  
  referredDoctor  User?    @relation("OrderReferredDoctor", fields: [referredDoctorId], references: [id], onDelete: SetNull)
  referredDoctorId String?
  
  // Additional fields
  partner         String
  scanningMode    String
  schedule        DateTime
  enterRemark     String
  estimateDate    DateTime
  dateOfApproach  DateTime
  
  // Relations
  orderProducts   OrderProduct[]
  files           File[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderProduct {
  id                    String   @id @default(uuid())
  
  // Relations
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId             String
  
  // Order product specific fields
  workType              String
  workSpecification     String
  shadeType             String
  finishingInstructions String
  componentDetails      String
  incaseOfAllAbutments  String
  occlusalStaining      String
  ponticDesign          String
  repeatCorrections     String
  enterReason           String
  unitNumbers           String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model File {
  id              String   @id @default(uuid())
  
  // Essential file data
  fileName        String
  fileSize        BigInt?
  fileType        String?
  fileExtension   String?
  
  // S3 storage
  s3Key           String
  
  // File categorization
  fileCategory    String?
  fileDescription String?
  
  // Upload metadata
  uploadDate      DateTime @default(now())
  uploadedBy      String?
  
  // Polymorphic relations
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Status
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


