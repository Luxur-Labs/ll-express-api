generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  LAB_MANAGER
  FRONT_OFFICE
  DOCTOR
  EMPLOYEE
}


model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String?
  passwordHash          String
  role                  Role
  employeeType          EmployeeType?     @relation(fields: [employeeTypeId], references: [id])
  employeeTypeId        String?
  technicianGroup       TechnicianGroup?  @relation("GroupMembers", fields: [technicianGroupId], references: [id])
  technicianGroupId     String?
  leadingGroup          TechnicianGroup?  @relation("GroupLeader")
  
  // Security fields
  failedLoginAttempts   Int               @default(0)
  accountLockedUntil    DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  /** When true, user must set a new password before using the app. */
  mustChangePassword    Boolean           @default(false)
  /** When false, the account is revoked and cannot log in. */
  isActive              Boolean           @default(true)

  // Profile fields
  dateOfBirth           DateTime?
  contact               String?
  document              String?
  profilePhoto          String?
  
  // Relations
  ordersAsDoctor        Order[]           @relation("OrderDoctor")
  ordersAsReferredDoctor Order[]          @relation("OrderReferredDoctor")
  clinicsCreated        Clinic[]          @relation("ClinicCreatedBy")
  clinicsUpdated        Clinic[]          @relation("ClinicUpdatedBy")
  productsCreated       Product[]         @relation("ProductCreatedBy")
  productsUpdated       Product[]         @relation("ProductUpdatedBy")
  patientsCreated       Patient[]         @relation("PatientCreatedBy")
  patientsUpdated       Patient[]         @relation("PatientUpdatedBy")
  ordersCreated         Order[]           @relation("OrderCreatedBy")
  ordersUpdated         Order[]           @relation("OrderUpdatedBy")
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model EmployeeType {
  id    String  @id @default(uuid())
  name  String  @unique
  users User[]
}

model TechnicianGroup {
  id        String  @id @default(uuid())
  name      String  @unique
  description String?
  isActive  Boolean @default(true)
  leaderId  String? @unique
  leader    User?   @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members   User[]  @relation("GroupMembers")
  orderAssignments OrderTechnicianGroup[]
}

model Clinic {
  id              String   @id @default(uuid())
  clinicName      String
  organizationId  String
  clientAddress   String
  contactNumber   String
  isActive        Boolean  @default(true)
  doctorName      String?
  /** Outstanding amount owed by the clinic (net of payments). */
  pendingBalance  Decimal  @default(0) @db.Decimal(12, 2)
  
  // Relations
  orders          Order[]
  billingInvoices BillingInvoice[]
  billingLedger   BillingLedgerEntry[]
  createdById     String?
  updatedById     String?
  createdBy       User?    @relation("ClinicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?    @relation("ClinicUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum BillingPeriodType {
  MONTHLY
  QUARTERLY
  WEEKLY
  CUSTOM
}

enum BillingLedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_ADJUSTMENT
  MANUAL
}

/// Multiple invoices per clinic+period are allowed (supplemental bills for new order lines).
/// Cancelled rows use cancelledAt; line-level de-dupe uses BillingInvoiceLine order keys.
model BillingInvoice {
  id                String              @id @default(uuid())
  clinicId          String
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceNumber     String              @unique
  periodType        BillingPeriodType
  periodLabel       String
  dateFrom          DateTime
  dateTo            DateTime
  invoiceDate       DateTime            @default(now())
  roundOff          Decimal             @default(0) @db.Decimal(10, 2)
  invoiceSubtotal   Decimal             @db.Decimal(12, 2)
  previousBalance   Decimal             @db.Decimal(12, 2)
  totalPayable      Decimal             @db.Decimal(12, 2)
  receivedAmount    Decimal             @default(0) @db.Decimal(12, 2)
  creditsAdjusted   Decimal             @default(0) @db.Decimal(12, 2)
  netPayable        Decimal             @db.Decimal(12, 2)
  totalInWords      String?
  isPaid            Boolean             @default(false)
  paidAt            DateTime?
  cancelledAt       DateTime?
  lines             BillingInvoiceLine[]
  ledgerEntries     BillingLedgerEntry[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([clinicId, cancelledAt])
}

model BillingInvoiceLine {
  id                  String          @id @default(uuid())
  invoiceId           String
  invoice             BillingInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId             String?
  orderProductId      String?
  voucherNo           String?
  deliveryDate        DateTime?
  patientName         String
  productDescription  String
  toothNo             String?
  unit                Int             @default(1)
  ratePerUnit         Decimal         @db.Decimal(12, 2)
  discountRate        Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal         @db.Decimal(12, 2)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
}

model BillingLedgerEntry {
  id          String                 @id @default(uuid())
  clinicId    String
  clinic      Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     BillingInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  entryType   BillingLedgerEntryType
  description String
  /** Positive increases amount owed by clinic; negative is payment or credit. */
  amount      Decimal                @db.Decimal(12, 2)
  createdAt   DateTime               @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  code        String?
  warranty    String?
  onPaperRate Decimal? @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  discount    Decimal  @db.Decimal(5, 2) @default(0)
  isActive    Boolean  @default(true)
  
  // Relations
  orderProducts OrderProduct[]
  createdById   String?
  updatedById   String?
  createdBy     User?    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Patient {
  id            String   @id @default(uuid())
  name          String
  age           Int
  gender        String
  contactNumber String?
  isActive      Boolean  @default(true)
  
  // Relations
  orders        Order[]
  createdById   String?
  updatedById   String?
  createdBy     User?    @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?    @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  doctorName      String?
  referenceName   String?
  
  // Relations
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId       String
  
  doctor          User?    @relation("OrderDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId        String?
  
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId        String
  
  referredDoctor  User?    @relation("OrderReferredDoctor", fields: [referredDoctorId], references: [id], onDelete: SetNull)
  referredDoctorId String?
  
  // Additional fields
  partner         String
  scanningMode    String?
  schedule        DateTime?
  enterRemark     String?
  estimateDate    DateTime
  dateOfApproach  DateTime?
  status          String @default("NEW")
  applicationStatus String @default("NEW")
  isActive        Boolean @default(true)
  
  // Relations
  orderProducts   OrderProduct[]
  files           File[]
  technicianGroups OrderTechnicianGroup[]
  transitions     OrderTransition[]
  createdById     String?
  updatedById     String?
  createdBy       User?    @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?    @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderProduct {
  id                    String   @id @default(uuid())
  
  // Relations
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId             String
  
  // Order product specific fields
  workType              String?
  workSpecification     String?
  shadeType             String
  finishingInstructions String
  componentDetails      String
  incaseOfAllAbutments  String
  occlusalStaining      String
  ponticDesign          String
  repeatCorrections     String
  enterReason           String
  unitNumbers           String?
  /** Agreed unit price for this line (defaults from Product.price when null). */
  unitPrice             Decimal? @db.Decimal(12, 2)
  /** Discount % for this line (defaults from Product.discount when null). */
  discountPercent       Decimal? @db.Decimal(5, 2)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OrderTechnicianGroup {
  id                String   @id @default(uuid())
  
  // Relations
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  
  technicianGroup   TechnicianGroup @relation(fields: [technicianGroupId], references: [id], onDelete: Cascade)
  technicianGroupId String
  
  // Assignment details
  assignedAt        DateTime @default(now())
  assignedBy        String?  // User ID who assigned this
  notes             String?  // Optional notes about the assignment
  
  // Status tracking
  isActive          Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Ensure unique order-technician group combination
  @@unique([orderId, technicianGroupId])
}

model OrderTransition {
  id              String   @id @default(uuid())
  
  // Relations
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  
  // Transition details
  fromState       String?
  toState         String
  transitionedBy  String?  // User ID who made the transition
  remarks         String?  // Optional remarks about the transition
  transitionOrder Int      // Sequential order of transitions for this order
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Ensure unique transition order per order
  @@unique([orderId, transitionOrder])
}

model File {
  id              String   @id @default(uuid())
  
  // Essential file data
  fileName        String
  fileSize        BigInt?
  fileType        String?
  fileExtension   String?
  
  // S3 storage
  s3Key           String
  
  // File categorization
  fileCategory    String?
  fileDescription String?
  
  // Upload metadata
  uploadDate      DateTime @default(now())
  uploadedBy      String?
  
  // Polymorphic relations
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Status
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Tracks each sheet upload / import run by admin.
model OrderImportBatch {
  id              String               @id @default(uuid())
  fileName        String?
  importedByEmail String?
  totalRows       Int                  @default(0)
  ordersAttempted Int                  @default(0)
  createdCount    Int                  @default(0)
  failedCount     Int                  @default(0)
  items           OrderImportBatchItem[]
  createdAt       DateTime             @default(now())
}

model OrderImportBatchItem {
  id           String           @id @default(uuid())
  batchId      String
  batch        OrderImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId      String
  status       String
  patientName  String?
  clinicName   String?
  productCount Int              @default(1)
  errorMessage String?
  draftJson    Json?
  createdAt    DateTime         @default(now())

  @@index([batchId])
  @@index([orderId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  action      AuditAction
  entityType  String
  entityId    String?
  entityLabel String?
  changes     Json?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

