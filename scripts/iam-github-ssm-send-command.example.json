{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrPushLuxurApi",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "EcrPushLuxurApiRepo",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload"
      ],
      "Resource": "arn:aws:ecr:ap-south-2:378595783871:repository/luxarlabs/expressapi"
    },
    {
      "Sid": "SsmRunDeployOnEc2",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-south-2:378595783871:instance/EC2_INSTANCE_ID",
        "arn:aws:ssm:ap-south-2:378595783871:document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "SsmReadCommandOutput",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
